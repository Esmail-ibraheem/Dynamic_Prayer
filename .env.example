# Copy to .env (Docker Compose reads it) or set these in your host's environment.

# Public https address of this server, without a trailing slash.
# Needed so Google Calendar and Outlook on the web can fetch the feed.
PUBLIC_BASE_URL=https://prayer.example.com

# 1 when running behind a reverse proxy that sets X-Forwarded-* headers.
TRUST_PROXY=1

# Optional
# PORT=8787
# HOST=0.0.0.0
# DB_PATH=data/waqt.db
# CITIES_PATH=data/cities.json
# LOG=0
